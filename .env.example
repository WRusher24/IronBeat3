# ---------------------------------------------------------------------------
# IronBeat environment variables
# Copy this file to .env.local for local development and add the same keys in
# your Vercel project settings for production.
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string (Project -> Connect -> Connection string).
# Use the pooled connection string for serverless deployments.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/ironbeat?sslmode=require"

# Secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a different value in production. Never commit the real value.
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: comma-separated list of Piped API instances, tried in order for
# search and (as a fallback) audio stream extraction.
# PIPED_API_INSTANCES="https://pipedapi.ducks.party,https://api.piped.private.coffee"

# Optional: comma-separated list of Invidious API instances, used as a fallback
# for search and as a stream proxy for iOS-friendly AAC audio.
# INVIDIOUS_INSTANCES="https://yt.chocolatemoo53.com,https://invidious.nerdvpn.de"

# Optional: how long (in seconds) successful search results are cached in memory.
# SEARCH_CACHE_TTL_SECONDS="180"

# Optional: canonical public URL, used for Open Graph/Twitter image URLs and
# metadata. Set this to your production URL on Vercel.
# NEXT_PUBLIC_APP_URL="https://ironbeat.vercel.app"
